#!/usr/bin/env bash

set -e

LANGUAGES=("bash" "haskell" "python")

# The tests run with coverage in their own build directory: coverage changes
# the configuration of the library, and in the default build directory every
# later 'cabal run magix' would rebuild it.
COVERAGE_BUILDDIR=dist-coverage

# Print the coverage of each library module by both test suites, the least
# covered first. It shows where tests are thin, and is no target. A module no
# test suite links has no coverage data; it is listed first, and the total
# leaves it out.
print_coverage_report() {
  local build mix package modules tix report
  build=$(echo "${COVERAGE_BUILDDIR}"/build/*/*/magix-*)
  mix="${build}/build/extra-compilation-artifacts/hpc/vanilla/mix"
  package=$(ls "${mix}")
  # Leave out the module Cabal generates.
  modules=$(printf '%s\n' "${mix}/${package}"/*.mix | sed 's|.*/||; s|\.mix$||' | grep -vx Paths_magix)
  tix="${COVERAGE_BUILDDIR}/magix.tix"
  hpc sum --union --include="${package}:" --exclude="${package}:Paths_magix" \
    --output="${tix}" "${build}"/t/*/hpc/vanilla/tix/*.tix
  report=$(hpc report --per-module --hpcdir="${mix}" "${tix}")
  awk -v prefix="${package}/" -v modules="${modules}" '
    function cell(n, d) { return d == 0 ? sprintf("%15s", "-") : sprintf("%4d%% %9s", 100 * n / d, n "/" d) }
    function row(m) { return sprintf("%-34s %s %s %s", m, cell(en, ed), cell(an, ad), cell(tn, td)) }
    function counts() { s = $NF; gsub(/[()]/, "", s); split(s, c, "/") }
    function flush() {
      if (m == "") return
      linked[m]
      print (ed == 0 ? 101 : 100 * en / ed) "\t" row(m) | sorted
      sen += en; sed += ed; san += an; sad += ad; stn += tn; std += td
    }
    BEGIN {
      sorted = "sort -n -k1,1 -k2,2 | cut -f2-"
      printf "%-34s %15s %15s %15s\n", "Module", "Expressions", "Alternatives", "Top-level"
    }
    /^-----<module / { flush(); m = substr($2, length(prefix) + 1); sub(/>-----$/, "", m) }
    / expressions used / { counts(); en = c[1]; ed = c[2] }
    / alternatives used / { counts(); an = c[1]; ad = c[2] }
    / top-level declarations used / { counts(); tn = c[1]; td = c[2] }
    END {
      flush()
      n = split(modules, all, "\n")
      for (i = 1; i <= n; i++)
        if (!(all[i] in linked))
          printf "-1\t%-34s %47s\n", all[i], "not linked by any test suite" | sorted
      close(sorted)
      en = sen; ed = sed; an = san; ad = sad; tn = stn; td = std
      print row("Total")
    }
  ' <<<"${report}"
}

echo "Cleaning up"
cabal clean
rm -rf "${COVERAGE_BUILDDIR}"

echo "Updating"
cabal update

echo "Building"
cabal build

echo "Testing with coverage"
cabal test --enable-coverage --builddir "${COVERAGE_BUILDDIR}"

echo "Coverage of the library by the test suites"
print_coverage_report

check_sample_scripts() {
  # Sample scripts.
  CACHE_DIR=$(mktemp -u -d -t magix-XXXXXX)
  echo "Temporary cache directory is ${CACHE_DIR}"
  for l in "${LANGUAGES[@]}"; do
    echo "Running sample scripts for language ${l}"
    dir="test-scripts/${l}"
    cabal run magix -- --cache-path "${CACHE_DIR}" -v "${dir}/args" -h and other args
    cabal run magix -- --cache-path "${CACHE_DIR}" -v "${dir}/empty"
    cabal run magix -- --cache-path "${CACHE_DIR}" -v "${dir}/hello-flake"
    cabal run magix -- --cache-path "${CACHE_DIR}" -v "${dir}/minimal"
    cabal run magix -- --cache-path "${CACHE_DIR}" -v "${dir}/minimal with spaces"
  done
}

check_parallel_builds() {
  # Parallel builds.
  CACHE_DIR_PARALLEL=$(mktemp -u -d -t magix-XXXXXX)
  # We assume Magix has been built.
  MAGIX=$(cabal list-bin magix)
  echo "Temporary cache directory for parallel builds is ${CACHE_DIR_PARALLEL}"
  for l in "${LANGUAGES[@]}"; do
    echo "Running parallel builds for language ${l}"
    dir="test-scripts/${l}"
    # We use `cabal exec`, because `cabal run` leads to weird linker errors
    # and core dumps... (Why)?
    parallel -N0 \
      cabal exec -- "${MAGIX}" --cache-path "${CACHE_DIR_PARALLEL}" -v "${dir}/minimal" \
      ::: {1..10}
  done
}

check_script_move() {
  # Check if Magix works after script has been moved.
  SCRIPT_DIR=$(mktemp -d -t magix-script-XXXXXX)
  echo "Temporary script path is ${SCRIPT_DIR}"
  SCRIPT_NAME_A="${SCRIPT_DIR}/script_a"
  SCRIPT_NAME_B="${SCRIPT_DIR}/script_b"

  cat <<EOF >"${SCRIPT_NAME_A}"
#!/usr/bin/env magix
#!magix bash
echo "Hello from the script!"
EOF

  cabal run magix -- --cache-path "${CACHE_DIR}" -v "${SCRIPT_NAME_A}"
  mv "${SCRIPT_NAME_A}" "${SCRIPT_NAME_B}"
  cabal run magix -- --cache-path "${CACHE_DIR}" -v "${SCRIPT_NAME_B}"
}

check_c_locale() {
  # The build output of Nix is UTF-8, also under a locale without it.
  for l in "${LANGUAGES[@]}"; do
    echo "Building under the C locale for language ${l}"
    LC_ALL=C cabal run magix -- --cache-path "${CACHE_DIR}" -v -f "test-scripts/${l}/hello-flake"
  done
}

fail() {
  echo "Check failed: $*" >&2
  exit 1
}

# Write a Bash script printing its second argument to the path given first.
write_script() {
  printf '#!/usr/bin/env magix\n#!magix bash\necho "%s"\n' "$2" >"$1"
}

# Assert the cache holds one build.
assert_one_build() {
  local results=("$1"/*/*-result)
  [[ ${#results[@]} -eq 1 && -e ${results[0]} ]] ||
    fail "expected one build in $1, found: ${results[*]}"
}

check_rebuild_replaces_superseded() {
  # An edited script replaces its build.
  local cache script_dir
  cache=$(mktemp -u -d -t magix-XXXXXX)
  script_dir=$(mktemp -d -t magix-script-XXXXXX)
  write_script "${script_dir}/script" "First version"
  cabal run magix -- --cache-path "${cache}" -v "${script_dir}/script"
  write_script "${script_dir}/script" "Second version"
  [[ $(cabal run -v0 magix -- --cache-path "${cache}" "${script_dir}/script" 2>/dev/null) == "Second version" ]] ||
    fail "the edited script does not run its second version"
  assert_one_build "${cache}"
}

check_failed_build_keeps_previous() {
  # A failed build of an edited script keeps the build it would supersede.
  local cache script_dir previous
  cache=$(mktemp -u -d -t magix-XXXXXX)
  script_dir=$(mktemp -d -t magix-script-XXXXXX)
  write_script "${script_dir}/script" "First version"
  cabal run magix -- --cache-path "${cache}" -v "${script_dir}/script"
  previous=$(echo "${cache}"/*/*-result)
  printf '#!/usr/bin/env magix\n#!magix bash\n#!packages magix-no-such-package\necho "Broken"\n' \
    >"${script_dir}/script"
  if cabal run magix -- --cache-path "${cache}" "${script_dir}/script"; then
    fail "the build of a script with a missing package succeeded"
  fi
  assert_one_build "${cache}"
  [[ $(echo "${cache}"/*/*-result) == "${previous}" ]] ||
    fail "the failed build removed the previous one"
}

check_deploy_keeps_build() {
  # A deploy moves the script behind the path it is invoked by: an unchanged
  # script is not rebuilt, and its build does not need the old location.
  local cache script_dir output
  cache=$(mktemp -u -d -t magix-XXXXXX)
  script_dir=$(mktemp -d -t magix-script-XXXXXX)
  mkdir "${script_dir}/old" "${script_dir}/new"
  write_script "${script_dir}/old/script" "Deployed"
  ln -s "${script_dir}/old/script" "${script_dir}/script"
  cabal run magix -- --cache-path "${cache}" -v "${script_dir}/script"
  cp "${script_dir}/old/script" "${script_dir}/new/script"
  rm -r "${script_dir}/old"
  ln -sfn "${script_dir}/new/script" "${script_dir}/script"
  output=$(cabal run -v0 magix -- --cache-path "${cache}" "${script_dir}/script" 2>&1)
  grep -q "Script has already been built" <<<"${output}" ||
    fail "the deployed script was rebuilt: ${output}"
  grep -q "^Deployed$" <<<"${output}" ||
    fail "the deployed script did not run: ${output}"
  assert_one_build "${cache}"
}

check_clean_stale() {
  # Removing stale entries keeps the slots of existing scripts only.
  local cache script_dir
  cache=$(mktemp -u -d -t magix-XXXXXX)
  script_dir=$(mktemp -d -t magix-script-XXXXXX)
  write_script "${script_dir}/kept" "Kept"
  write_script "${script_dir}/removed" "Removed"
  cabal run magix -- --cache-path "${cache}" "${script_dir}/kept"
  cabal run magix -- --cache-path "${cache}" "${script_dir}/removed"
  rm "${script_dir}/removed"
  # An entry of the layout before slots.
  touch "${cache}/00-old.lock"
  cabal run magix -- clean-magix-cache --stale --cache-path "${cache}" -v
  [[ $(find "${cache}" -mindepth 1 -maxdepth 1 ! -name lock | wc -l) -eq 1 ]] ||
    fail "stale entries remain in ${cache}"
  [[ $(readlink "${cache}"/*/path) == "${script_dir}/kept" ]] ||
    fail "the slot of the existing script was removed"
  assert_one_build "${cache}"
}

check_stale_keeps_non_ascii_path() {
  # A slot records a non-ASCII path under any locale, and removing stale
  # entries under another locale keeps the slot.
  #
  # WTNG: posix-treat-arguments-using-filesystem-encoding
  # (haskell/process#388). Run magix through `cabal exec` once a `process`
  # carrying that fix reaches the dev shell.
  local magix cache script_dir script b c
  magix=$(cabal list-bin magix)
  script_dir=$(mktemp -d -t magix-script-XXXXXX)
  mkdir "${script_dir}/dä"
  script="${script_dir}/dä/script"
  write_script "${script}" "Non-ASCII"
  for b in C C.UTF-8; do
    for c in C C.UTF-8; do
      cache=$(mktemp -u -d -t magix-XXXXXX)
      magix_datadir="${PWD}" LC_ALL="${b}" "${magix}" --cache-path "${cache}" "${script}" >/dev/null
      magix_datadir="${PWD}" LC_ALL="${c}" "${magix}" clean-magix-cache --stale --cache-path "${cache}"
      [[ $(readlink "${cache}"/*/path) == "${script}" ]] ||
        fail "built under ${b}, removing stale entries under ${c} removed the slot of ${script}"
    done
  done
}

check_flake_nix_path_entry() {
  # A 'flake:' entry of NIX_PATH resolves through the user flake registry to
  # its path.
  local cache config nixpkgs output
  cache=$(mktemp -u -d -t magix-XXXXXX)
  config=$(mktemp -d -t magix-config-XXXXXX)
  nixpkgs=$(nix-instantiate --find-file nixpkgs)
  printf '{"version":2,"flakes":[{"from":{"type":"indirect","id":"magix-nixpkgs"},"to":{"type":"path","path":"%s"}}]}' \
    "${nixpkgs}" >"${config}/registry.json"
  output=$(NIX_CONFIG_HOME="${config}" NIX_PATH=nixpkgs=flake:magix-nixpkgs \
    cabal run -v0 magix -- --cache-path "${cache}" -v test-scripts/bash/minimal 2>&1) ||
    fail "the build with a 'flake:' entry failed: ${output}"
  grep -qF "ChannelBuild \"${nixpkgs}\"" <<<"${output}" ||
    fail "the 'flake:' entry did not resolve to ${nixpkgs}: ${output}"
}

check_nixpkgs_path_builds_against_it() {
  # The build uses the Nixpkgs given by '--nixpkgs-path', not the one in
  # NIX_PATH.
  local cache nixpkgs
  cache=$(mktemp -u -d -t magix-XXXXXX)
  nixpkgs=$(nix-instantiate --find-file nixpkgs)
  NIX_PATH=nixpkgs=/nonexistent cabal run magix -- --cache-path "${cache}" \
    --nixpkgs-path "${nixpkgs}" -v test-scripts/bash/minimal ||
    fail "the build ignores --nixpkgs-path ${nixpkgs}"
}

check_flake() {
  # The checks build the sample scripts through 'lib.build', with the magix of
  # the flake; CI built it in the step before.
  echo "Checking the flake"
  nix flake check --print-build-logs
}

check_sample_scripts
check_flake
check_nixpkgs_path_builds_against_it
check_flake_nix_path_entry
check_c_locale
check_parallel_builds
check_script_move
check_rebuild_replaces_superseded
check_failed_build_keeps_previous
check_deploy_keeps_build
check_clean_stale
check_stale_keeps_non_ascii_path
